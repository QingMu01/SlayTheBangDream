<Project>
    <PropertyGroup>
        <ImplicitUsings>true</ImplicitUsings>
        <LangVersion>13.0</LangVersion>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!--
        游戏本体定位（本体稳定版 / beta 版并行时按分支或本机切换）。
        解析优先级：命令行 -p:Sts2Dir=...  >  Directory.Build.local.props  >  环境变量 STS2_DIR / GODOT_EXE  >  下列默认值。
        切版本只改本机文件（已 gitignore），不要改这里的默认值、也不要跨分支合并这些默认值。
    -->
    <PropertyGroup>
        <Sts2Dir Condition="'$(Sts2Dir)' == '' and '$(STS2_DIR)' != ''">$(STS2_DIR)</Sts2Dir>
        <Sts2Dir Condition="'$(Sts2Dir)' == ''">/home/QingMu/.local/share/Steam/steamapps/common/Slay the Spire 2</Sts2Dir>
        <GodotExe Condition="'$(GodotExe)' == '' and '$(GODOT_EXE)' != ''">$(GODOT_EXE)</GodotExe>
        <GodotExe Condition="'$(GodotExe)' == ''">/home/QingMu/Software/megadot-4.5.1-m.14-linux-x86_64-editor-csharp/MegaDot_v4.5.1-stable_mono_linux.x86_64</GodotExe>
    </PropertyGroup>

    <!-- 本机/分支局部覆盖（不入库）：模板见 Directory.Build.local.props.example -->
    <Import Project="Directory.Build.local.props" Condition="Exists('Directory.Build.local.props')"/>

    <PropertyGroup>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Dir)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <Optimize>false</Optimize>
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <Publicize Include="sts2" IncludeCompilerGeneratedMembers="false" IncludeVirtualMembers="false"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="sts2" HintPath="$(Sts2DataDir)/sts2.dll" Private="True"/>
        <Reference Include="0Harmony" HintPath="$(Sts2DataDir)/0Harmony.dll" Private="True"/>
    </ItemGroup>

    <!-- sts2.dll 的第三方运行时依赖。Godot 编辑器保留-->
    <ItemGroup>
        <Reference Include="Sentry" HintPath="$(Sts2DataDir)/Sentry.dll" Private="True"/>
        <Reference Include="Sentry.Godot" HintPath="$(Sts2DataDir)/Sentry.Godot.dll" Private="True"/>
        <Reference Include="SharpGen.Runtime" HintPath="$(Sts2DataDir)/SharpGen.Runtime.dll" Private="True"/>
        <Reference Include="SharpGen.Runtime.COM" HintPath="$(Sts2DataDir)/SharpGen.Runtime.COM.dll" Private="True"/>
        <Reference Include="SmartFormat" HintPath="$(Sts2DataDir)/SmartFormat.dll" Private="True"/>
        <Reference Include="SmartFormat.ZString" HintPath="$(Sts2DataDir)/SmartFormat.ZString.dll" Private="True"/>
        <Reference Include="Steamworks.NET" HintPath="$(Sts2DataDir)/Steamworks.NET.dll" Private="True"/>
        <Reference Include="System.IO.Hashing" HintPath="$(Sts2DataDir)/System.IO.Hashing.dll" Private="True"/>
        <Reference Include="Vortice.DXGI" HintPath="$(Sts2DataDir)/Vortice.DXGI.dll" Private="True"/>
        <Reference Include="Vortice.DirectX" HintPath="$(Sts2DataDir)/Vortice.DirectX.dll" Private="True"/>
        <Reference Include="Vortice.Mathematics" HintPath="$(Sts2DataDir)/Vortice.Mathematics.dll" Private="True"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="STS2.RitsuLib" Version="0.5.20"/>
        <!--        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all"/>-->
    </ItemGroup>

    <ItemGroup>
        <Content Include="export_presets.cfg"/>
        <Content Include="project.godot"/>
    </ItemGroup>

</Project>